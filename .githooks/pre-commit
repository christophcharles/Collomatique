#!/bin/sh
# Versioned pre-commit hook. Git only runs hooks from .git/hooks, which is
# never committed, so it has to be pointed here once per clone:
#
#     git config core.hooksPath .githooks
#
set -e

# Refuse the commit if the workspace is not rustfmt-clean.
if ! cargo fmt --all --check; then
    echo >&2
    echo "pre-commit: rustfmt found unformatted code (see the diff above)." >&2
    echo "pre-commit: run 'cargo fmt --all' and stage the changes." >&2
    exit 1
fi

staged() { git diff --cached --name-only | grep -qx "$1"; }

# The version is written out by hand in three places. Read them as the commit
# would contain them, not as the working tree happens to have them, and refuse
# a commit that would leave them disagreeing. Cargo.lock repeats the version
# once per workspace member, but cargo writes those; nothing in pkgs/flatpak/
# declares a version at all, build.sh takes it from Cargo.toml.
staged_content() { git show ":$1" 2>/dev/null || true; }

cargo_version=$(staged_content Cargo.toml | awk '
    /^\[workspace\.package\]/ { in_section = 1; next }
    /^\[/                     { in_section = 0 }
    in_section && /^version = / { gsub(/"/, "", $3); print $3; exit }')
nix_version=$(staged_content pkgs/nix/collomatique.nix | awk '
    /^[[:space:]]*version = / { gsub(/[";]/, "", $3); print $3; exit }')

if [ -z "$cargo_version" ] || [ -z "$nix_version" ]; then
    echo "pre-commit: could not read the version out of Cargo.toml or" >&2
    echo "  pkgs/nix/collomatique.nix. The hook expects both to declare one." >&2
    exit 1
fi

if [ "$cargo_version" != "$nix_version" ]; then
    echo "pre-commit: the two files declaring the version disagree." >&2
    echo "  Cargo.toml:                $cargo_version" >&2
    echo "  pkgs/nix/collomatique.nix: $nix_version" >&2
    exit 1
fi

# The third one cannot repeat the string. python/Cargo.toml is what maturin
# reads to build the wheel's metadata, and it wants PEP 440, which allows
# nothing numeric after a prerelease -- so `0.1.0-alpha.1.99` is refused
# outright. That crate therefore carries the same version with the dev counter
# cut off, and this cuts it off the same way rather than trusting the two to
# be kept in step by hand. A prerelease shape the rule does not cover is
# refused rather than guessed at, for the same reason as the foreign
# Cargo.lock source further down.
expected_python_version=$(printf '%s' "$cargo_version" | python3 -c '
import re, sys

workspace = sys.stdin.read().strip()
release, _, prerelease = workspace.partition("-")

if not prerelease:
    print(release)
    sys.exit(0)

shape = re.fullmatch(r"(alpha|beta|rc)\.(\d+)(?:\.\d+)?", prerelease)
if shape is None:
    sys.exit(
        "pre-commit: the version has a prerelease this hook does not know how\n"
        f"  to truncate: {workspace}\n"
        "  Teach the rule in .githooks/pre-commit before committing."
    )

print(f"{release}-{shape.group(1)}.{shape.group(2)}")
') || exit 1

python_version=$(staged_content python/Cargo.toml | awk '
    /^\[package\]/ { in_section = 1; next }
    /^\[/          { in_section = 0 }
    in_section && /^version = / { gsub(/"/, "", $3); print $3; exit }')

if [ -z "$python_version" ]; then
    echo "pre-commit: could not read the version out of python/Cargo.toml." >&2
    echo "  That crate writes one out rather than inheriting the workspace's;" >&2
    echo "  the hook expects a [package] version = \"...\" line." >&2
    exit 1
fi

if [ "$python_version" != "$expected_python_version" ]; then
    echo "pre-commit: python/Cargo.toml does not carry the version in Cargo.toml" >&2
    echo "  with its dev counter cut off." >&2
    echo "  Cargo.toml:        $cargo_version" >&2
    echo "  python/Cargo.toml: $python_version" >&2
    echo "  expected there:    $expected_python_version" >&2
    exit 1
fi

# The cargoHash in pkgs/nix/collomatique.nix covers the whole lock file,
# dependency edges included, so any change to Cargo.lock changes it. Demanding
# the two be staged together is therefore exact. There is one hash in the tree
# and no second one to check: pkgs/nix/collomatique-python.nix builds the same
# workspace and takes both the vendor derivation and the version from this
# file rather than repeating them.
if staged Cargo.lock && ! staged pkgs/nix/collomatique.nix; then
    echo "pre-commit: Cargo.lock is staged but pkgs/nix/collomatique.nix is not." >&2
    echo "  Regenerate the cargoHash in pkgs/nix/collomatique.nix and stage it." >&2
    exit 1
fi

# pkgs/flatpak/cargo-sources.json is different: it is derived from the crates.io
# packages of Cargo.lock and from nothing else, so a lock change that only moves
# dependency edges around leaves it byte-identical and there is nothing to
# stage. Check what actually matters instead — that the two agree. Each archive
# entry of the json carries its crate's checksum, so the two sets of checksums
# must match exactly. Checked on every commit, not only when one of them is
# staged: a stale json that slipped through an earlier commit is worth catching
# too.
lock_sums=$(staged_content Cargo.lock | sed -n 's/^checksum = "\(.*\)"$/\1/p' | sort)
json_sums=$(staged_content pkgs/flatpak/cargo-sources.json |
            sed -n 's/.*"sha256": "\(.*\)".*/\1/p' | sort)

if [ "$lock_sums" != "$json_sums" ]; then
    echo "pre-commit: pkgs/flatpak/cargo-sources.json does not match Cargo.lock." >&2
    echo "  Run ./pkgs/flatpak/generate-cargo-sources.sh and stage the result." >&2
    exit 1
fi

# That comparison only sees packages that have a checksum, which today means all
# of them: every source in the lock is crates.io. A git dependency would carry
# no checksum and slip through unnoticed, so refuse rather than check less than
# the file contains.
foreign=$(staged_content Cargo.lock |
          sed -n 's/^source = "\(.*\)"$/\1/p' |
          grep -v '^registry+https://github.com/rust-lang/crates.io-index$' |
          sort -u || true)
if [ -n "$foreign" ]; then
    echo "pre-commit: Cargo.lock has a dependency that is not from crates.io:" >&2
    echo "$foreign" | sed 's/^/  /' >&2
    echo "  The cargo-sources.json check above compares checksums and cannot see" >&2
    echo "  it. Teach the hook about this source kind before committing." >&2
    exit 1
fi

# The Windows application manifest is the one file in the tree that Windows
# refuses to start the program over. The activation context is built before the
# process runs, so a manifest that does not parse is fatal rather than ignored:
# the exe never starts, and the message box says "the side-by-side configuration
# is incorrect" without naming a file. It is easy to break by accident too, an
# XML comment being unable to contain two dashes in a row while this project
# writes that dash everywhere else. Read the staged bytes, not the working tree,
# so a fix that has not been staged does not pass. Checked on every commit for
# the same reason as the json above: a broken one that slipped through earlier
# is worth catching. Empty means it is not in the index at all, which is what a
# commit deleting it looks like.
manifest=gtk4/collomatique-gtk4.exe.manifest
manifest_xml=$(staged_content "$manifest")

if [ -n "$manifest_xml" ] && ! printf '%s\n' "$manifest_xml" | python3 -c '
import sys, xml.etree.ElementTree as ET

try:
    ET.fromstring(sys.stdin.buffer.read())
except ET.ParseError as error:
    sys.exit(f"  {error}")
'; then
    echo "pre-commit: $manifest is not well-formed XML." >&2
    echo "  Windows would refuse to start the program with it." >&2
    exit 1
fi

# Keep everything derived from the master icon in sync with it. The .ico is in
# the same list as the scaled copies because it comes out of the same script and
# from the same master -- it is the Windows executable's icon, and the one
# Explorer draws on .collomatique files.
if staged resources/icons/collomatique.png; then
    for derived in collomatique-128.png collomatique-256.png collomatique-512.png \
                   collomatique.ico; do
        if ! staged "resources/icons/$derived"; then
            echo "pre-commit: the master icon is staged but" >&2
            echo "  resources/icons/$derived is not." >&2
            echo "  Run ./resources/icons/generate-sizes.sh and stage the result." >&2
            exit 1
        fi
    done
fi
