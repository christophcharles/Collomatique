import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;
import "collomatique_queries" as *;

type EmptyPrefilledGroupData = {
    subject_id: SubjectId,
    group_list_id: GroupListId,
    slot_id: SlotId,
    week: GlobalWeek,
    group_num: GroupNum,
};

query empty_prefilled_groups(db: Db) -> [EmptyPrefilledGroupData] = "
WITH ordered_weeks AS (
    SELECT
        pw.period_id,
        pw.week_index,
        pw.has_interrogations,
        (
            SELECT COUNT(*)
            FROM period_weeks pw2
            JOIN periods p2 ON p2.id = pw2.period_id
            JOIN periods p ON p.id = pw.period_id
            WHERE (p2.position < p.position)
               OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
),
interrogation_info AS (
    SELECT s.id AS slot_id, ow.global_week_number AS global_week,
           s.subject_id, ow.period_id, glsa.group_list_id
    FROM slots s
    JOIN ordered_weeks ow ON ow.has_interrogations = 1
    JOIN subject_interrogation_params sip ON sip.subject_id = s.subject_id
    JOIN group_list_subject_associations glsa
        ON glsa.period_id = ow.period_id AND glsa.subject_id = s.subject_id
    JOIN group_lists gl ON gl.id = glsa.group_list_id AND gl.filling_type = 'prefilled'
    WHERE NOT EXISTS (
        SELECT 1 FROM week_pattern_disabled_weeks wpd
        WHERE wpd.week_pattern_id = s.week_pattern_id
          AND wpd.period_id = ow.period_id AND wpd.week_index = ow.week_index
    )
)
SELECT ii.subject_id, ii.group_list_id, ii.slot_id, ii.global_week AS week, glgn.group_index AS group_num
FROM interrogation_info ii
JOIN group_list_group_names glgn ON glgn.group_list_id = ii.group_list_id
WHERE NOT EXISTS (
    SELECT 1 FROM prefilled_group_students pgs
    JOIN assignments a
        ON a.student_id = pgs.student_id
       AND a.subject_id = ii.subject_id
       AND a.period_id = ii.period_id
    WHERE pgs.group_list_id = ii.group_list_id
      AND pgs.group_index = glgn.group_index
)
";

type AutomaticGroupInterrogationData = {
    slot_id: SlotId,
    week: GlobalWeek,
    group_num: GroupNum,
    group_list_id: GroupListId,
    subject_id: SubjectId,
    period_id: ?PeriodId,
};

query automatic_group_interrogations(db: Db) -> [AutomaticGroupInterrogationData] = "
WITH ordered_weeks AS (
    SELECT
        pw.period_id,
        pw.week_index,
        pw.has_interrogations,
        (
            SELECT COUNT(*)
            FROM period_weeks pw2
            JOIN periods p2 ON p2.id = pw2.period_id
            JOIN periods p ON p.id = pw.period_id
            WHERE (p2.position < p.position)
               OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
)
SELECT s.id AS slot_id, ow.global_week_number AS week,
       glgn.group_index AS group_num,
       glsa.group_list_id, glsa.subject_id, ow.period_id
FROM slots s
JOIN ordered_weeks ow ON ow.has_interrogations = 1
JOIN subject_interrogation_params sip ON sip.subject_id = s.subject_id
JOIN group_list_subject_associations glsa
    ON glsa.period_id = ow.period_id AND glsa.subject_id = s.subject_id
JOIN group_lists gl ON gl.id = glsa.group_list_id AND gl.filling_type = 'automatic'
JOIN group_list_group_names glgn ON glgn.group_list_id = glsa.group_list_id
WHERE NOT EXISTS (
    SELECT 1 FROM week_pattern_disabled_weeks wpd
    WHERE wpd.week_pattern_id = s.week_pattern_id
      AND wpd.period_id = ow.period_id AND wpd.week_index = ow.week_index
)
";

/// Le groupe `data.group_num` de la liste `data.group_list_id` ne peut avoir colle dans la matière `data.subject_id` sans élève associé
let enforce_automatic_group_enrollment(db: Db, data: AutomaticGroupInterrogationData) -> Constraint =
    $GroupInInterrogation(data.slot_id, data.week, data.group_num) <==
        sum student_id in students_for_subject_period_group_list(db, data.group_list_id, data.subject_id, data.period_id cast! PeriodId) {
            $StudentInGroup(student_id, data.group_list_id, data.group_num)
        };

/// Le groupe `group_num` de la liste `group_list_id` ne peut avoir colle dans la matière `subject_id` sans élève associé
let enforce_prefilled_group_enrollment(subject_id: SubjectId, group_list_id: GroupListId, slot_id: SlotId, week: GlobalWeek, group_num: GroupNum) -> Constraint =
    $GroupInInterrogation(slot_id, week, group_num) === 0;

pub let constraint(db: Db) -> Constraint =
    forall data in empty_prefilled_groups(db) {
        enforce_prefilled_group_enrollment(data.subject_id, data.group_list_id, data.slot_id, data.week, data.group_num)
    } and
    forall data in automatic_group_interrogations(db) {
        enforce_automatic_group_enrollment(db, data)
    };
