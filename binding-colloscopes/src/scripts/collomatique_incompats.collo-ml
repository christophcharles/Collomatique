import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;
import "collomatique_queries" as *;

pub let constraint(db: Db) -> Constraint =
    forall incompat_data in get_incompat_rules_per_student_per_week(db) {
        enforce_incompat_week(db, incompat_data)
    };

type IncompatData = {
    incompat_id: IncompatId,
    minimum_free_slots: ?Int, // <-- for some reason this appears nullable???
    student_id: StudentId,
    global_week: GlobalWeek,
    period_id: PeriodId,
    week: LocalWeek,
};

query get_incompat_rules_per_student_per_week(db: Db) -> [IncompatData] = "
SELECT
    i.id AS incompat_id,
    i.minimum_free_slots AS minimum_free_slots,
    a.student_id AS student_id,
    COALESCE(
        (
            SELECT SUM(pw2_count.week_count)
            FROM (
                SELECT COUNT(*) AS week_count
                FROM periods p2
                JOIN period_weeks pw2 ON pw2.period_id = p2.id
                WHERE p2.position < p.position
                GROUP BY p2.id
            ) pw2_count
        ),
        0
    ) + pw.week_index AS global_week,
    pw.period_id AS period_id,
    pw.week_index AS week

FROM incompats i
JOIN assignments a
    ON a.subject_id = i.subject_id
JOIN periods p
    ON p.id = a.period_id
JOIN period_weeks pw
    ON pw.period_id = p.id
WHERE pw.has_interrogations = 1
    AND (
        i.week_pattern_id IS NULL
        OR NOT EXISTS (
            SELECT 1
            FROM week_pattern_disabled_weeks wpdw
            WHERE wpdw.week_pattern_id = i.week_pattern_id
              AND wpdw.period_id = pw.period_id
              AND wpdw.week_index = pw.week_index
        )
    )
    AND NOT EXISTS (
        SELECT 1
        FROM subject_excluded_periods sep
        WHERE sep.subject_id = i.subject_id
          AND sep.period_id = p.id
    );
";

let enforce_incompat_week(db: Db, incompat_data: IncompatData) -> Constraint =
    let slots = get_incompat_slots(db, incompat_data.incompat_id) {
        if |slots| == incompat_data.minimum_free_slots {
            enforce_saturated_incompat_week(db, incompat_data, slots)
        } else {
            enforce_non_saturated_incompat_week(db, incompat_data, slots)
        }
    };

type IncompatSlotData = {
    day: WeekdayNum,
    start_time: Time,
    duration: Duration,
};

query get_incompat_slots(db: Db, incompat_id: IncompatId) -> [IncompatSlotData] =
    "SELECT day, start_time, duration_minutes AS duration FROM incompat_slots WHERE incompat_id = ?";

let enforce_saturated_incompat_week(db: Db, incompat_data: IncompatData, incompat_slots: [IncompatSlotData]) -> Constraint =
    forall incompat_slot in incompat_slots {
        student_not_at_incompat_slot(db, incompat_data.student_id, incompat_data.global_week, incompat_data.period_id, incompat_data.week, incompat_slot)
    };

/// Au moins `incompat_data.minimum_free_slots` créneaux disponibles pour `incompat_data.student_id` pendant la semaine `incompat_data.global_week` pour l'incompatibilité `incompat_data.incompat_id`
let enforce_non_saturated_incompat_week(db: Db, incompat_data: IncompatData, incompat_slots: [IncompatSlotData]) -> Constraint =
    sum incompat_slot in incompat_slots {
        $StudentNotAtIncompatSlot(db, incompat_data.student_id, incompat_data.global_week, incompat_data.period_id, incompat_data.week, incompat_slot)
    } >== (incompat_data.minimum_free_slots ?? 0);

reify student_not_at_incompat_slot as $StudentNotAtIncompatSlot;

/// Pas de colle pour `student_id` pendant la semaine `global_week`, le jour `incompat_slot.day`, à partir de `incompat_slot.start_time` pendant `incompat_slot.duration` minutes
let student_not_at_incompat_slot(db: Db, student_id: StudentId, global_week: GlobalWeek, period_id: PeriodId, week: LocalWeek, incompat_slot: IncompatSlotData) -> Constraint =
    let time_slot_desc = TimeSlotDesc {
        period_id: period_id,
        week: week,
        day: incompat_slot.day,
        start_time: incompat_slot.start_time,
        duration: incompat_slot.duration,
    } {
        forall slot_id in get_slots_for_student_during(db, student_id, time_slot_desc) {
            $StudentAtInterrogation(db, student_id, slot_id, global_week) === 0
        }
    };