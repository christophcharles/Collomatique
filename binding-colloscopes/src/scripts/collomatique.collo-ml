import "collomatique_db" as *;
import "collomatique_group_count_per_interrogation" as group_count_per_interrogation;
import "collomatique_groups_filled_by_ascending_order" as groups_filled_by_ascending_order;
import "collomatique_incompats" as incompats;
import "collomatique_interrogation_cost" as interrogation_cost;
import "collomatique_limits" as limits;
import "collomatique_one_interrogation_at_once" as one_interrogation_at_once;
import "collomatique_students_have_groups" as students_have_groups;
import "collomatique_students_per_group_for_subject" as students_per_group_for_subject;
import "collomatique_periodicity_amount_for_every_arbitrary_block" as periodicity_afab;
import "collomatique_periodicity_amount_in_year" as periodicity_amount_in_year;
import "collomatique_forbidden_groups" as forbidden_groups;
import "collomatique_periodicity_exactly_periodic" as periodicity_ep;
import "collomatique_periodicity_once_for_every_block_of_weeks" as periodicity_ofeb;
import "collomatique_students_per_group" as students_per_group;

pub let default_constraint(db: Db) -> Constraint =
    one_interrogation_at_once::constraint(db) and
    group_count_per_interrogation::constraint(db) and
    students_per_group::constraint(db) and
    limits::constraint(db) and
    students_have_groups::constraint(db) and
    students_per_group_for_subject::constraint(db) and
    incompats::constraint(db) and
    groups_filled_by_ascending_order::constraint(db) and
    periodicity_amount_in_year::constraint(db) and
    periodicity_afab::constraint(db) and
    periodicity_ep::constraint(db) and
    periodicity_ofeb::constraint(db) and
    forbidden_groups::constraint(db);

pub let default_objective(db: Db) -> [Constraint | LinExpr] =
    limits::objective(db) + [interrogation_cost::objective(db)];


