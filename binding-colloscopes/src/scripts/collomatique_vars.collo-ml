import "collomatique_db" as *;
import "collomatique_types" as *;
import "collomatique_queries" as *;

let group_in_interrogation(slot: SlotId, week: GlobalWeek, group: GroupNum) -> Constraint =
    $GroupInInterrogationInternal(Int(slot), Int(week), Int(group)) === 1;

pub reify group_in_interrogation as $GroupInInterrogation;

let count_groups_in_interrogation(db: Db, slot: SlotId, week: GlobalWeek) -> LinExpr =
    sum group in groups_for_interrogation(db, slot, week) {
        $GroupInInterrogation(slot, week, group)
    };

let interrogation_has_groups(db: Db, slot: SlotId, week: GlobalWeek) -> Constraint =
    count_groups_in_interrogation(db, slot, week) >== 1;

pub reify interrogation_has_groups as $InterrogationHasGroups;

let student_in_group(student: StudentId, group_list: GroupListId, group: GroupNum) -> Constraint =
    $StudentGroup(Int(group_list), Int(student)) === Int(group);

pub reify student_in_group as $StudentInGroup;

let group_has_students(db: Db, group_list: GroupListId, group: GroupNum) -> Constraint =
    if group_list_is_prefilled(db, group_list) {
        (group_prefilled_student_count(db, group_list, group) ?? 0) >== 1
    } else {
        sum student in students_for_automatic_group_list(db, group_list) {
            $StudentInGroup(student, group_list, group)
        } >== 1
    };

pub reify group_has_students as $GroupHasStudents;

let student_at_interrogation_in_group(student: StudentId, slot: SlotId, week: GlobalWeek, group_list: GroupListId, group: GroupNum) -> Constraint =
    // Use inequalities to reduce the amount of helper variables
    $StudentInGroup(student, group_list, group) >== 1 and $GroupInInterrogation(slot, week, group) >== 1;

pub reify student_at_interrogation_in_group as $StudentAtInterrogationInGroup;

let student_at_interrogation(db: Db, student: StudentId, slot: SlotId, week: GlobalWeek) -> Constraint =
    match group_list_for_interrogation(db, slot, week) {
        gl as GroupListId {
            if group_list_is_prefilled(db, gl) {
                $GroupInInterrogation(
                    slot, week, student_prefilled_group(db, student, gl) ?? GroupNum(-1)
                )
            } else {
                sum group in groups_for_group_list(db, gl) {
                    $StudentAtInterrogationInGroup(student, slot, week, gl, group)
                }
            }
        }
        _ as None {
            0
        }
    } >== 1; // Test for bigger than one: we can't actually exceed it but this will save some reification constraints

pub reify student_at_interrogation as $StudentAtInterrogation;

