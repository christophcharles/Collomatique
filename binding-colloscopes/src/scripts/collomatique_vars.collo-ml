import "collomatique_db" as *;

query groups_for_interrogation(db: Db, slot: Int, week: Int) -> [Int] = "
WITH ordered_weeks AS (
    -- Map each (period_id, week_index) to a global week number
    -- by counting all weeks in periods that come before, plus the week_index itself
    SELECT
        pw.period_id,
        pw.week_index,
        pw.has_interrogations,
        (
            SELECT COUNT(*)
            FROM period_weeks pw2
            JOIN periods p2 ON p2.id = pw2.period_id
            JOIN periods p ON p.id = pw.period_id
            WHERE (p2.position < p.position)
               OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
),
slot_info AS (
    SELECT s.subject_id, s.week_pattern_id
    FROM slots s
    WHERE s.id = ?  -- parameter
),
target_week AS (
    -- Find the period_id and week_index for the given global week number
    SELECT period_id, week_index, has_interrogations
    FROM ordered_weeks
    WHERE global_week_number = ?  -- parameter
),
week_is_disabled AS (
    -- Check if the week is disabled via the slot's week_pattern
    SELECT 1
    FROM week_pattern_disabled_weeks wpd
    JOIN target_week tw ON tw.period_id = wpd.period_id AND tw.week_index = wpd.week_index
    JOIN slot_info si ON si.week_pattern_id = wpd.week_pattern_id
)
SELECT glgn.group_index AS group_num
FROM target_week tw
JOIN slot_info si
JOIN group_list_subject_associations glsa
    ON glsa.period_id = tw.period_id
   AND glsa.subject_id = si.subject_id
JOIN group_list_group_names glgn
    ON glgn.group_list_id = glsa.group_list_id
WHERE tw.has_interrogations = 1
  AND NOT EXISTS (SELECT 1 FROM week_is_disabled)
";

let count_groups_in_interrogation(db: Db, slot: Int, week: Int) -> LinExpr =
    sum group in groups_for_interrogation(db, slot, week) {
        $GroupInInterrogation(slot, week, group)
    };

let interrogation_has_groups(db: Db, slot: Int, week: Int) -> Constraint =
    count_groups_in_interrogation(db, slot, week) >== 1;

pub reify interrogation_has_groups as $InterrogationHasGroups;

let student_in_group(student: Int, group_list: Int, group: Int) -> Constraint =
    $StudentGroup(group_list, student) === group;

pub reify student_in_group as $StudentInGroup;

query group_list_filling(db: Db, group_list: Int) -> ?String =
    "SELECT filling_type FROM group_lists WHERE id = ?";

let group_list_is_prefilled(db: Db, group_list: Int) -> Bool =
    group_list_filling(db, group_list) == "prefilled";

query group_prefilled_student_count(db: Db, group_list: Int, group: Int) -> ?Int =
    "SELECT COUNT(*) AS student_count FROM prefilled_group_students WHERE group_list_id = ? AND group_index = ?";

query students_for_automatic_group_list(db: Db, group_list: Int) -> [Int] =
    "SELECT id FROM students EXCEPT SELECT student_id AS id FROM automatic_group_excluded_students WHERE group_list_id = ?";

let group_has_students(db: Db, group_list: Int, group: Int) -> Constraint =
    if group_list_is_prefilled(db, group_list) {
        (group_prefilled_student_count(db, group_list, group) ?? 0) >== 1
    } else {
        sum student in students_for_automatic_group_list(db, group_list) {
            $StudentInGroup(student, group_list, group)
        } >== 1
    };

pub reify group_has_students as $GroupHasStudents;

let student_at_interrogation_in_group(student: Student, interrogation: Interrogation, group: Group) -> Constraint =
    // Use inequalities to reduce the amount of helper variables
    $StudentInGroup(student.id, group.group_list.id, group.num) >== 1 and $GroupInInterrogation(interrogation.slot_id, interrogation.week.num, group.num) >== 1;

pub reify student_at_interrogation_in_group as $StudentAtInterrogationInGroup;

let student_prefilled_group(student: Student, group_list: GroupList) -> Int =
    // returns -1 if no group corresponds
    fold group in group_list.groups with result = -1 {
        /* with a consistent database only one such group might exists
           but in principle this code returns the last one found */
        if student in group.prefilled_students {
            group.num
        } else {
            result
        }
    };

let student_at_interrogation(student: Student, interrogation: Interrogation) -> Constraint =
    match interrogation.group_list {
        gl as GroupList {
            if gl.prefilled {
                $GroupInInterrogation(
                    interrogation.slot_id, interrogation.week.num,
                    student_prefilled_group(student, gl)
                )
            } else {
                sum group in gl.groups {
                    $StudentAtInterrogationInGroup(student, interrogation, group)
                }
            }
        }
        _ as None {
            0
        }
    } >== 1; // Test for bigger than one: we can't actually exceed it but this will save some reification constraints

pub reify student_at_interrogation as $StudentAtInterrogation;

