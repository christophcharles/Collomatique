import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;
import "collomatique_queries" as *;

let count_groups_in_interrogation(interrogation: Interrogation) -> LinExpr =
    match interrogation.group_list {
        gl as GroupList {
            sum group in gl.groups {
                $GroupInInterrogation(SlotId(interrogation.slot_id), GlobalWeek(interrogation.week.num), GroupNum(group.num))
            }
        }
        _ as None {
            LinExpr(0)
        }
    };

let max_group_per_interrogation(interrogation: Interrogation) -> Constraint =
    count_groups_in_interrogation(interrogation) <== interrogation.subject.max_group_per_interrogation;

let min_group_per_interrogation(db: Db, interrogation: Interrogation) -> Constraint =
    count_groups_in_interrogation(interrogation) >== interrogation.subject.min_group_per_interrogation * $InterrogationHasGroups(db, SlotId(interrogation.slot_id), GlobalWeek(interrogation.week.num));

let enforce_group_count(db: Db, interrogation: Interrogation) -> Constraint =
    max_group_per_interrogation(interrogation) and min_group_per_interrogation(db, interrogation);

pub let constraint(db: Db) -> Constraint =
    forall interrogation in @[Interrogation] {
        enforce_group_count(db, interrogation)
    };
