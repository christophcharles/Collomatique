import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;
import "collomatique_queries" as *;

let count_groups_in_interrogation(db: Db, slot: SlotId, week: GlobalWeek) -> LinExpr =
    sum group in groups_for_interrogation(db, slot, week) {
        $GroupInInterrogation(slot, week, group)
    };

/// Minimum de `min` groupe(s) pour la colle du créneau `slot` de la semaine `week`
let enforce_min_group(db: Db, slot: SlotId, week: GlobalWeek, min: Int) -> Constraint =
    count_groups_in_interrogation(db, slot, week) >== min * $InterrogationHasGroups(db, slot, week);

/// Maximum de `max` groupe(s) pour la colle du créneau `slot` de la semaine `week`
let enforce_max_group(db: Db, slot: SlotId, week: GlobalWeek, max: Int) -> Constraint =
    count_groups_in_interrogation(db, slot, week) <== max;

type InterrogationData = {
    slot_id: SlotId,
    week: GlobalWeek,
    min_group_count: Int,
    max_group_count: Int,
};

query min_max_group_for_interrogations(db: Db) -> [InterrogationData] = "
WITH ordered_weeks AS (
    SELECT
        pw.period_id,
        pw.week_index,
        pw.has_interrogations,
        (
            SELECT COUNT(*)
            FROM period_weeks pw2
            JOIN periods p2 ON p2.id = pw2.period_id
            JOIN periods p ON p.id = pw.period_id
            WHERE (p2.position < p.position)
               OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
)
SELECT
    s.id AS slot_id,
    ow.global_week_number AS week,
    sip.groups_per_interrogation_min AS min_group_count,
    sip.groups_per_interrogation_max AS max_group_count
FROM slots s
JOIN ordered_weeks ow ON ow.has_interrogations = 1
JOIN subject_interrogation_params sip ON sip.subject_id = s.subject_id
WHERE NOT EXISTS (
    SELECT 1
    FROM week_pattern_disabled_weeks wpd
    WHERE wpd.week_pattern_id = s.week_pattern_id
      AND wpd.period_id = ow.period_id
      AND wpd.week_index = ow.week_index
);";

let enforce_group_count(db: Db, interrogation_data: InterrogationData) -> Constraint =
    if interrogation_data.min_group_count > 0 {
        enforce_min_group(db, interrogation_data.slot_id, interrogation_data.week, interrogation_data.min_group_count) and
        enforce_max_group(db, interrogation_data.slot_id, interrogation_data.week, interrogation_data.max_group_count)
    } else {
        enforce_max_group(db, interrogation_data.slot_id, interrogation_data.week, interrogation_data.max_group_count)
    };

pub let constraint(db: Db) -> Constraint =
    forall interrogation_data in min_max_group_for_interrogations(db) {
        enforce_group_count(db, interrogation_data)
    };