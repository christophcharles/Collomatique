import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;

pub let constraint(db: Db) -> Constraint =
    forall pair in students_with_group_lists(db) {
        enforce_student_has_group(pair)
    };

type StudentGroupListPair = {
    group_list_id: GroupListId,
    student_id: StudentId,
};

query students_with_group_lists(db: Db) -> [StudentGroupListPair] = "
SELECT gl.id AS group_list_id, s.id AS student_id
FROM group_lists gl
CROSS JOIN students s
WHERE gl.filling_type = 'automatic'
  AND NOT EXISTS (
    SELECT 1 FROM automatic_group_excluded_students ages
    WHERE ages.group_list_id = gl.id AND ages.student_id = s.id
  )
";

/// L'élève `pair.student_id` doit avoir un groupe dans la liste `pair.group_list_id`
pub let enforce_student_has_group(pair: StudentGroupListPair) -> Constraint =
    $StudentGroup(Int(pair.group_list_id), Int(pair.student_id)) >== 0;