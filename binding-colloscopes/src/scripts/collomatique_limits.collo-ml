import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;

let count_interrogations_in_day(db: Db, student: Student, day: Day) -> LinExpr =
    sum time_slot in day.time_slots {
        sum interrogation in time_slot.interrogations where
            (student in interrogation.students) &&
            interrogation.subject.take_into_account
        {
            $StudentAtInterrogation(db, StudentId(student.id), SlotId(interrogation.slot_id), GlobalWeek(interrogation.week.num))
        }
    };

let max_per_day_for(db: Db, student: Student) -> Constraint =
    forall day in @[Day] where day.week.period in student.periods {
        count_interrogations_in_day(db, student, day) <== student.max_interrogations_per_day
    };

let max_per_day(db: Db, hard: Bool) -> Constraint =
    forall student in @[Student] where student.hard_max_interrogations_per_day == hard {
        max_per_day_for(db, student)
    };

let count_interrogations_in_week(db: Db, student: Student, week: Week) -> LinExpr =
    sum day in week.days {
        count_interrogations_in_day(db, student, day)
    };

let max_per_week_for(db: Db, student: Student) -> Constraint =
    forall week in @[Week] where week.period in student.periods {
        count_interrogations_in_week(db, student, week) <== student.max_interrogations_per_week
    };

let max_per_week(db: Db, hard: Bool) -> Constraint =
    forall student in @[Student] where student.hard_max_interrogations_per_week == hard {
        max_per_week_for(db, student)
    };

let min_per_week_for(db: Db, student: Student) -> Constraint =
    forall week in @[Week] where week.period in student.periods {
        count_interrogations_in_week(db, student, week) >== student.min_interrogations_per_week
    };

let min_per_week(db: Db, hard: Bool) -> Constraint =
    forall student in @[Student] where student.hard_min_interrogations_per_week == hard {
        min_per_week_for(db, student)
    };

pub let constraint(db: Db) -> Constraint = max_per_day(db, true) and max_per_week(db, true) and min_per_week(db, true);

pub let objective(db: Db) -> [Constraint] = [max_per_day(db, false), max_per_week(db, false), min_per_week(db, false)];