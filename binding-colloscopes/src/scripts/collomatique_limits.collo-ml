import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;
import "collomatique_queries" as *;

type StudentDayData = {
    student_id: StudentId,
    max_value: ?Int,
    global_week: GlobalWeek,
    period_id: ?PeriodId,
    week: ?LocalWeek,
    day: WeekdayNum,
};

type StudentWeekMaxData = {
    student_id: StudentId,
    max_value: ?Int,
    global_week: GlobalWeek,
    period_id: ?PeriodId,
    week: ?LocalWeek,
};

type StudentWeekMinData = {
    student_id: StudentId,
    min_value: ?Int,
    global_week: GlobalWeek,
    period_id: ?PeriodId,
    week: ?LocalWeek,
};

query students_max_per_day(db: Db, hard: Bool) -> [StudentDayData] = "
WITH ordered_weeks AS (
    SELECT pw.period_id, pw.week_index,
        (SELECT COUNT(*) FROM period_weeks pw2
         JOIN periods p2 ON p2.id = pw2.period_id
         JOIN periods p ON p.id = pw.period_id
         WHERE (p2.position < p.position)
            OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
    WHERE pw.has_interrogations = 1
)
SELECT
    se.student_id AS student_id,
    se.max_interrogations_per_day_value AS max_value,
    ow.global_week_number AS global_week,
    ow.period_id AS period_id,
    ow.week_index AS week,
    d.day AS day
FROM settings_effective se
CROSS JOIN ordered_weeks ow
CROSS JOIN (SELECT 0 AS day UNION ALL SELECT 1 UNION ALL SELECT 2
    UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5
    UNION ALL SELECT 6) d
WHERE se.max_interrogations_per_day_soft IS NOT NULL
  AND se.max_interrogations_per_day_value IS NOT NULL
  AND se.max_interrogations_per_day_soft = CASE WHEN ? THEN 0 ELSE 1 END
  AND NOT EXISTS (
    SELECT 1 FROM student_excluded_periods sep
    WHERE sep.student_id = se.student_id AND sep.period_id = ow.period_id
  )
";

query students_max_per_week(db: Db, hard: Bool) -> [StudentWeekMaxData] = "
WITH ordered_weeks AS (
    SELECT pw.period_id, pw.week_index,
        (SELECT COUNT(*) FROM period_weeks pw2
         JOIN periods p2 ON p2.id = pw2.period_id
         JOIN periods p ON p.id = pw.period_id
         WHERE (p2.position < p.position)
            OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
    WHERE pw.has_interrogations = 1
)
SELECT
    se.student_id AS student_id,
    se.interrogations_per_week_max_value AS max_value,
    ow.global_week_number AS global_week,
    ow.period_id AS period_id,
    ow.week_index AS week
FROM settings_effective se
CROSS JOIN ordered_weeks ow
WHERE se.interrogations_per_week_max_soft IS NOT NULL
  AND se.interrogations_per_week_max_value IS NOT NULL
  AND se.interrogations_per_week_max_soft = CASE WHEN ? THEN 0 ELSE 1 END
  AND NOT EXISTS (
    SELECT 1 FROM student_excluded_periods sep
    WHERE sep.student_id = se.student_id AND sep.period_id = ow.period_id
  )
";

query students_min_per_week(db: Db, hard: Bool) -> [StudentWeekMinData] = "
WITH ordered_weeks AS (
    SELECT pw.period_id, pw.week_index,
        (SELECT COUNT(*) FROM period_weeks pw2
         JOIN periods p2 ON p2.id = pw2.period_id
         JOIN periods p ON p.id = pw.period_id
         WHERE (p2.position < p.position)
            OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
    WHERE pw.has_interrogations = 1
)
SELECT
    se.student_id AS student_id,
    se.interrogations_per_week_min_value AS min_value,
    ow.global_week_number AS global_week,
    ow.period_id AS period_id,
    ow.week_index AS week
FROM settings_effective se
CROSS JOIN ordered_weeks ow
WHERE se.interrogations_per_week_min_soft IS NOT NULL
  AND se.interrogations_per_week_min_value IS NOT NULL
  AND se.interrogations_per_week_min_soft = CASE WHEN ? THEN 0 ELSE 1 END
  AND NOT EXISTS (
    SELECT 1 FROM student_excluded_periods sep
    WHERE sep.student_id = se.student_id AND sep.period_id = ow.period_id
  )
";

/// Au maximum `data.max_value` colles le jour `data.day` de la semaine `data.global_week` pour `data.student_id`
let enforce_max_per_day(db: Db, data: StudentDayData) -> Constraint =
    let desc = TimeSlotDesc {
        period_id: data.period_id cast! PeriodId,
        week: data.week cast! LocalWeek,
        day: data.day,
        start_time: Time(0),
        duration: Duration(1440),
    } {
        sum slot_id in get_counted_slots_for_student_during(db, data.student_id, desc) {
            $StudentAtInterrogation(db, data.student_id, slot_id, data.global_week)
        } <== data.max_value cast! Int
    };

let max_per_day(db: Db, hard: Bool) -> Constraint =
    forall data in students_max_per_day(db, hard) {
        enforce_max_per_day(db, data)
    };

/// Au maximum `data.max_value` colles la semaine `data.global_week` pour `data.student_id`
let enforce_max_per_week(db: Db, data: StudentWeekMaxData) -> Constraint =
    sum day_num in days() {
        let desc = TimeSlotDesc {
            period_id: data.period_id cast! PeriodId,
            week: data.week cast! LocalWeek,
            day: day_num,
            start_time: Time(0),
            duration: Duration(1440),
        } {
            sum slot_id in get_counted_slots_for_student_during(db, data.student_id, desc) {
                $StudentAtInterrogation(db, data.student_id, slot_id, data.global_week)
            }
        }
    } <== data.max_value cast! Int;

let max_per_week(db: Db, hard: Bool) -> Constraint =
    forall data in students_max_per_week(db, hard) {
        enforce_max_per_week(db, data)
    };

/// Au minimum `data.min_value` colles la semaine `data.global_week` pour `data.student_id`
let enforce_min_per_week(db: Db, data: StudentWeekMinData) -> Constraint =
    sum day_num in days() {
        let desc = TimeSlotDesc {
            period_id: data.period_id cast! PeriodId,
            week: data.week cast! LocalWeek,
            day: day_num,
            start_time: Time(0),
            duration: Duration(1440),
        } {
            sum slot_id in get_counted_slots_for_student_during(db, data.student_id, desc) {
                $StudentAtInterrogation(db, data.student_id, slot_id, data.global_week)
            }
        }
    } >== data.min_value cast! Int;

let min_per_week(db: Db, hard: Bool) -> Constraint =
    forall data in students_min_per_week(db, hard) {
        enforce_min_per_week(db, data)
    };

pub let constraint(db: Db) -> Constraint = max_per_day(db, true) and max_per_week(db, true) and min_per_week(db, true);

pub let objective(db: Db) -> [Constraint] = [max_per_day(db, false), max_per_week(db, false), min_per_week(db, false)];
