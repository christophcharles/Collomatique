import "collomatique_db" as *;
import "collomatique_vars" as *;
import "collomatique_types" as *;
import "collomatique_queries" as *;

// --- Types ---

type PairingRuleData = {
    pairing_rule_id: Int,
    student_id: ?StudentId,
    global_week: ?GlobalWeek,
    antecedent_subject_id: SubjectId,
    antecedent_should_have: Int,
    consequent_subject_id: SubjectId,
    consequent_should_have: Int,
};

// --- Queries ---

/// Get all (student, week, rule) tuples where a hard pairing rule applies
query get_hard_pairing_data(db: Db) -> [PairingRuleData] = "
SELECT
    pr.id AS pairing_rule_id,
    a_ant.student_id AS student_id,
    COALESCE(
        (
            SELECT SUM(pw2_count.week_count)
            FROM (
                SELECT COUNT(*) AS week_count
                FROM periods p2
                JOIN period_weeks pw2 ON pw2.period_id = p2.id
                WHERE p2.position < p.position
                GROUP BY p2.id
            ) pw2_count
        ),
        0
    ) + pw.week_index AS global_week,
    pr.antecedent_subject_id AS antecedent_subject_id,
    pr.antecedent_should_have AS antecedent_should_have,
    pr.consequent_subject_id AS consequent_subject_id,
    pr.consequent_should_have AS consequent_should_have
FROM pairing_rules pr
JOIN assignments a_ant
    ON a_ant.subject_id = pr.antecedent_subject_id
JOIN assignments a_con
    ON a_con.subject_id = pr.consequent_subject_id
    AND a_con.student_id = a_ant.student_id
    AND a_con.period_id = a_ant.period_id
JOIN periods p
    ON p.id = a_ant.period_id
JOIN period_weeks pw
    ON pw.period_id = p.id
WHERE pw.has_interrogations = 1
    AND pr.soft = 0
    AND NOT EXISTS (
        SELECT 1 FROM pairing_rule_excluded_periods prep
        WHERE prep.pairing_rule_id = pr.id AND prep.period_id = p.id
    )
    AND NOT EXISTS (
        SELECT 1 FROM subject_excluded_periods sep
        WHERE sep.subject_id = pr.antecedent_subject_id AND sep.period_id = p.id
    )
    AND NOT EXISTS (
        SELECT 1 FROM subject_excluded_periods sep
        WHERE sep.subject_id = pr.consequent_subject_id AND sep.period_id = p.id
    );
";

/// Get all (student, week, rule) tuples where a soft pairing rule applies
query get_soft_pairing_data(db: Db) -> [PairingRuleData] = "
SELECT
    pr.id AS pairing_rule_id,
    a_ant.student_id AS student_id,
    COALESCE(
        (
            SELECT SUM(pw2_count.week_count)
            FROM (
                SELECT COUNT(*) AS week_count
                FROM periods p2
                JOIN period_weeks pw2 ON pw2.period_id = p2.id
                WHERE p2.position < p.position
                GROUP BY p2.id
            ) pw2_count
        ),
        0
    ) + pw.week_index AS global_week,
    pr.antecedent_subject_id AS antecedent_subject_id,
    pr.antecedent_should_have AS antecedent_should_have,
    pr.consequent_subject_id AS consequent_subject_id,
    pr.consequent_should_have AS consequent_should_have
FROM pairing_rules pr
JOIN assignments a_ant
    ON a_ant.subject_id = pr.antecedent_subject_id
JOIN assignments a_con
    ON a_con.subject_id = pr.consequent_subject_id
    AND a_con.student_id = a_ant.student_id
    AND a_con.period_id = a_ant.period_id
JOIN periods p
    ON p.id = a_ant.period_id
JOIN period_weeks pw
    ON pw.period_id = p.id
WHERE pw.has_interrogations = 1
    AND pr.soft = 1
    AND NOT EXISTS (
        SELECT 1 FROM pairing_rule_excluded_periods prep
        WHERE prep.pairing_rule_id = pr.id AND prep.period_id = p.id
    )
    AND NOT EXISTS (
        SELECT 1 FROM subject_excluded_periods sep
        WHERE sep.subject_id = pr.antecedent_subject_id AND sep.period_id = p.id
    )
    AND NOT EXISTS (
        SELECT 1 FROM subject_excluded_periods sep
        WHERE sep.subject_id = pr.consequent_subject_id AND sep.period_id = p.id
    );
";

type SlotWeekData = {
    slot_id: SlotId,
    global_week: GlobalWeek,
};

/// Get all slots for a given subject that are active on a given global week
/// (respecting week patterns and subject exclusions)
query get_subject_slots_for_week(db: Db, subject_id: SubjectId, global_week: GlobalWeek) -> [SlotId] = "
WITH ordered_weeks AS (
    SELECT pw.period_id, pw.week_index,
        (SELECT COUNT(*) FROM period_weeks pw2
         JOIN periods p2 ON p2.id = pw2.period_id
         JOIN periods p ON p.id = pw.period_id
         WHERE (p2.position < p.position)
            OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
    WHERE pw.has_interrogations = 1
)
SELECT s.id AS slot_id
FROM slots s
JOIN ordered_weeks ow ON ow.global_week_number = ?2
WHERE s.subject_id = ?1
AND (
    s.week_pattern_id IS NULL
    OR NOT EXISTS (
        SELECT 1 FROM week_pattern_disabled_weeks wpdw
        WHERE wpdw.week_pattern_id = s.week_pattern_id
          AND wpdw.period_id = ow.period_id
          AND wpdw.week_index = ow.week_index
    )
)
AND NOT EXISTS (
    SELECT 1 FROM subject_excluded_periods sep
    WHERE sep.subject_id = s.subject_id
      AND sep.period_id = ow.period_id
);
";

// --- LinExpr helper ---

/// Sum of $StudentAtInterrogation over all slots for a given subject on a given week.
/// Can be > 1 if multiple interrogations of the same subject are allowed in the same week.
let student_has_interrogation_in(db: Db, student_id: StudentId, subject_id: SubjectId, global_week: GlobalWeek) -> LinExpr =
    sum slot_id in get_subject_slots_for_week(db, subject_id, global_week) {
        $StudentAtInterrogation(db, student_id, slot_id, global_week)
    };

/// Maximum number of interrogation slots for a given subject on a given week.
let student_max_interrogation_count_in(db: Db, subject_id: SubjectId, global_week: GlobalWeek) -> Int =
    |get_subject_slots_for_week(db, subject_id, global_week)|;

/// Reified binary variable: 1 iff student has at least one interrogation in the subject on that week.
/// Only used for A → ¬B when the antecedent subject can have multiple interrogations per week.
let student_has_interrogation_in_constraint(db: Db, student_id: StudentId, subject_id: SubjectId, global_week: GlobalWeek) -> Constraint =
    student_has_interrogation_in(db, student_id, subject_id, global_week) >== 1;

reify student_has_interrogation_in_constraint as $StudentHasInterrogationIn;

// --- Individual constraint forms ---

/// Si l'élève `student_id` a une interrogation dans la matière `ant_subject` pendant la semaine `global_week`, il doit aussi en avoir une dans la matière `con_subject`
let enforce_having_implies_having(db: Db, student_id: StudentId, ant_subject: SubjectId, con_subject: SubjectId, global_week: GlobalWeek) -> Constraint =
    student_has_interrogation_in(db, student_id, ant_subject, global_week)
        <== student_max_interrogation_count_in(db, ant_subject, global_week)
            * student_has_interrogation_in(db, student_id, con_subject, global_week);

/// Si l'élève `student_id` a une interrogation dans la matière `ant_subject` pendant la semaine `global_week`, il ne doit pas en avoir dans la matière `con_subject`
let enforce_having_implies_not_having(db: Db, student_id: StudentId, ant_subject: SubjectId, con_subject: SubjectId, global_week: GlobalWeek) -> Constraint =
    if (subject_is_at_most_once_per_week(db, ant_subject) cast! Int) == 1 {
        student_has_interrogation_in(db, student_id, con_subject, global_week)
            <== student_max_interrogation_count_in(db, con_subject, global_week)
                * (1 - student_has_interrogation_in(db, student_id, ant_subject, global_week))
    } else {
        student_has_interrogation_in(db, student_id, con_subject, global_week)
            <== student_max_interrogation_count_in(db, con_subject, global_week)
                * (1 - $StudentHasInterrogationIn(db, student_id, ant_subject, global_week))
    };

/// Si l'élève `student_id` n'a pas d'interrogation dans la matière `ant_subject` pendant la semaine `global_week`, il doit en avoir une dans la matière `con_subject`
let enforce_not_having_implies_having(db: Db, student_id: StudentId, ant_subject: SubjectId, con_subject: SubjectId, global_week: GlobalWeek) -> Constraint =
    student_has_interrogation_in(db, student_id, ant_subject, global_week)
        + student_has_interrogation_in(db, student_id, con_subject, global_week) >== 1;

/// Si l'élève `student_id` n'a pas d'interrogation dans la matière `ant_subject` pendant la semaine `global_week`, il ne doit pas en avoir dans la matière `con_subject`
let enforce_not_having_implies_not_having(db: Db, student_id: StudentId, ant_subject: SubjectId, con_subject: SubjectId, global_week: GlobalWeek) -> Constraint =
    student_has_interrogation_in(db, student_id, con_subject, global_week)
        <== student_max_interrogation_count_in(db, con_subject, global_week)
            * student_has_interrogation_in(db, student_id, ant_subject, global_week);

// --- Core dispatch for one pairing rule ---

let enforce_pairing_rule(db: Db, data: PairingRuleData) -> Constraint =
    let student_id = data.student_id cast! StudentId {
    let global_week = data.global_week cast! GlobalWeek {
        if data.antecedent_should_have == 1 {
            if data.consequent_should_have == 1 {
                enforce_having_implies_having(db, student_id, data.antecedent_subject_id, data.consequent_subject_id, global_week)
            } else {
                enforce_having_implies_not_having(db, student_id, data.antecedent_subject_id, data.consequent_subject_id, global_week)
            }
        } else {
            if data.consequent_should_have == 1 {
                enforce_not_having_implies_having(db, student_id, data.antecedent_subject_id, data.consequent_subject_id, global_week)
            } else {
                enforce_not_having_implies_not_having(db, student_id, data.antecedent_subject_id, data.consequent_subject_id, global_week)
            }
        }
    }};

// --- Public constraint and objective ---

pub let constraint(db: Db) -> Constraint =
    forall data in get_hard_pairing_data(db) {
        enforce_pairing_rule(db, data)
    };

pub let objective(db: Db) -> [Constraint] =
    [enforce_pairing_rule(db, data)
     for data in get_soft_pairing_data(db)];
