import "collomatique_db" as *;
import "collomatique_types" as *;
import "collomatique_queries" as queries;
import "collomatique_periodicity_helpers" as helpers;

type AmountInYearData = {
    subject_id: SubjectId,
    student_id: StudentId,
    count_min: ?Int,
    count_max: ?Int,
    min_sep: ?Int,
};

query subjects_students_amount_in_year(db: Db) -> [AmountInYearData] = "
SELECT DISTINCT sip.subject_id, a.student_id,
       sip.aiy_count_min AS count_min, sip.aiy_count_max AS count_max,
       sip.aiy_minimum_week_separation AS min_sep
FROM subject_interrogation_params sip
JOIN assignments a ON a.subject_id = sip.subject_id
WHERE sip.aiy_count_min IS NOT NULL
";

let enforce_amount_in_year(db: Db, data: AmountInYearData) -> Constraint =
    let min = data.count_min cast! Int {
        let max = data.count_max cast! Int {
            if min == max {
                helpers::enforce_exact_interrogation_count(db, data.student_id, data.subject_id, GlobalWeek(0), queries::last_global_week(db), min)
            } else {
                helpers::enforce_min_interrogation_count(db, data.student_id, data.subject_id, GlobalWeek(0), queries::last_global_week(db), min) and
                helpers::enforce_max_interrogation_count(db, data.student_id, data.subject_id, GlobalWeek(0), queries::last_global_week(db), max)
            }
        }
    };

pub let constraint(db: Db) -> Constraint =
    forall data in subjects_students_amount_in_year(db) {
        enforce_amount_in_year(db, data) and helpers::enforce_min_separation(db, data.student_id, data.subject_id, data.min_sep ?? 0)
    };
