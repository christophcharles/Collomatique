import "collomatique_db" as *;
import "collomatique_types" as *;
import "collomatique_periodicity_helpers" as helpers;

type OfebData = {
    subject_id: ?SubjectId,
    student_id: ?StudentId,
    first_week: ?GlobalWeek | String | Bool,
    last_week: ?GlobalWeek | String | Bool,
    weeks_per_block: ?Int,
};

type OfebSeparationData = {
    subject_id: SubjectId,
    student_id: StudentId,
    min_sep: ?Int,
};

query ofeb_feasible_data(db: Db) -> [OfebData] = "
WITH
all_weeks AS (
    SELECT pw.period_id, pw.has_interrogations,
        (SELECT COUNT(*) FROM period_weeks pw2
         JOIN periods p2 ON p2.id = pw2.period_id
         JOIN periods p ON p.id = pw.period_id
         WHERE (p2.position < p.position)
            OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
),
period_bounds AS (
    SELECT period_id,
           MIN(global_week_number) AS first_week,
           MAX(global_week_number) AS last_week
    FROM all_weeks
    GROUP BY period_id
),
period_active_count AS (
    SELECT period_id, COUNT(*) AS active_count
    FROM all_weeks
    WHERE has_interrogations = 1
    GROUP BY period_id
)
SELECT DISTINCT
    sip.subject_id, a.student_id,
    pb.first_week, pb.last_week,
    sip.ofeb_weeks_per_block AS weeks_per_block
FROM subject_interrogation_params sip
JOIN assignments a ON a.subject_id = sip.subject_id
JOIN period_bounds pb ON pb.period_id = a.period_id
JOIN period_active_count pac ON pac.period_id = a.period_id
WHERE sip.ofeb_weeks_per_block IS NOT NULL
AND NOT EXISTS (
    SELECT 1 FROM subject_excluded_periods sep
    WHERE sep.subject_id = sip.subject_id AND sep.period_id = a.period_id
)
AND pac.active_count >= sip.ofeb_weeks_per_block
AND pac.active_count % sip.ofeb_weeks_per_block = 0
";

query ofeb_infeasible_data(db: Db) -> [OfebData] = "
WITH
all_weeks AS (
    SELECT pw.period_id, pw.has_interrogations,
        (SELECT COUNT(*) FROM period_weeks pw2
         JOIN periods p2 ON p2.id = pw2.period_id
         JOIN periods p ON p.id = pw.period_id
         WHERE (p2.position < p.position)
            OR (p2.position = p.position AND pw2.week_index < pw.week_index)
        ) AS global_week_number
    FROM period_weeks pw
),
period_bounds AS (
    SELECT period_id,
           MIN(global_week_number) AS first_week,
           MAX(global_week_number) AS last_week
    FROM all_weeks
    GROUP BY period_id
),
period_active_count AS (
    SELECT period_id, COUNT(*) AS active_count
    FROM all_weeks
    WHERE has_interrogations = 1
    GROUP BY period_id
)
SELECT DISTINCT
    sip.subject_id, a.student_id,
    pb.first_week, pb.last_week,
    sip.ofeb_weeks_per_block AS weeks_per_block
FROM subject_interrogation_params sip
JOIN assignments a ON a.subject_id = sip.subject_id
JOIN period_bounds pb ON pb.period_id = a.period_id
JOIN period_active_count pac ON pac.period_id = a.period_id
WHERE sip.ofeb_weeks_per_block IS NOT NULL
AND NOT EXISTS (
    SELECT 1 FROM subject_excluded_periods sep
    WHERE sep.subject_id = sip.subject_id AND sep.period_id = a.period_id
)
AND pac.active_count % sip.ofeb_weeks_per_block != 0
";

query ofeb_separation(db: Db) -> [OfebSeparationData] = "
SELECT DISTINCT sip.subject_id, a.student_id,
       sip.ofeb_minimum_week_separation AS min_sep
FROM subject_interrogation_params sip
JOIN assignments a ON a.subject_id = sip.subject_id
WHERE sip.ofeb_minimum_week_separation IS NOT NULL
";

/// Le nombre de semaines actives dans la période n'est pas un multiple de la périodicité `data.weeks_per_block` (matière: `data.subject_id`, élève: `data.student_id`, semaines `data.first_week` à `data.last_week`)
let infeasible_ofeb(data: OfebData) -> Constraint = infeasible;

let enforce_ofeb(db: Db, data: OfebData) -> Constraint =
    forall block in helpers::juxtapose_weeks(db, data.first_week cast! GlobalWeek, data.last_week cast! GlobalWeek, data.weeks_per_block cast! Int) {
        helpers::enforce_exact_interrogation_count(db, data.student_id cast! StudentId, data.subject_id cast! SubjectId, block.first_week cast! GlobalWeek, block.last_week cast! GlobalWeek, 1)
    };

pub let constraint(db: Db) -> Constraint =
    forall data in ofeb_feasible_data(db) {
        enforce_ofeb(db, data)
    } and
    forall data in ofeb_infeasible_data(db) {
        infeasible_ofeb(data)
    } and
    forall data in ofeb_separation(db) {
        helpers::enforce_min_separation(db, data.student_id, data.subject_id, data.min_sep ?? 0)
    };
